# syntax=docker/dockerfile:1.7

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libmariadb-dev \
    libmariadb-dev-compat \
    pkg-config \
    && python -m venv "$VIRTUAL_ENV" \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt

RUN pip install --upgrade pip "setuptools<81" wheel \
    && pip install --no-cache-dir -r /tmp/requirements.txt

FROM base AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmariadb3 \
    libglib2.0-0 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    fonts-dejavu-core \
    build-essential \
    gcc \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY . /app
COPY src/lib/strategy/.env.example /app/src/lib/strategy/.env

# Single shared image for all 5 backend services (app-backend, tdms-backend,
# interface-manager, auth-service, sarvam-ai) — they were always built from
# this exact same runtime-base (same requirements.txt, same venv, same
# `COPY . /app`), so 5 separate target images never bought anything besides
# 5x the build/push/pull work. Which service runs is now selected entirely
# in docker-compose.yml / stack-compose.yml via `working_dir:` + `command:`
# per service, not by which Dockerfile target was built.
EXPOSE 7000 7250 8000 7500 16000
