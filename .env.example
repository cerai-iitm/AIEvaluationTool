# This is an example for gpu is hosted outside of docker and app is running inside docker, if you are using docker for gpu
# OLLAMA_URL="http://host.docker.internal:11434"
# GPU_URL="http://host.docker.internal:16000"

# this is for local hosted GPU without Docker, if you are using docker for GPU, then use the above two lines instead of below two lines
# OLLAMA_URL="http://localhost:11434"
# GPU_URL="http://localhost:16000"

OLLAMA_URL="http://ollama:11434"
GPU_URL="http://sarvam-ai:16000"

LLM_AS_JUDGE_MODEL="qwen3:32b"

# Hugging Face token. Required to run Sarvam AI (used to download its models).
HF_TOKEN=""

PERSPECTIVE_API_KEY=""
SARVAM_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

TIME_ZONE="Asia/Kolkata"

# Public port nginx listens on (default 8100). Uncomment and change it if 8100 is taken.
# NGINX_PORT=8100
